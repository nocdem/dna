unstake_destination_pubkey = REPLACE_ME_5184_ZEROS
unstake_destination_fp     = REPLACE_ME_FOUNDATION_MULTISIG_ADDRESS
self_stake                 = 1000000000000000
commission_bps             = 500

[validator]
pubkey                     = REPLACE_ME_VALIDATOR_4_PUBKEY
unstake_destination_pubkey = REPLACE_ME_5184_ZEROS
unstake_destination_fp     = REPLACE_ME_FOUNDATION_MULTISIG_ADDRESS
self_stake                 = 1000000000000000
commission_bps             = 500

[validator]
pubkey                     = REPLACE_ME_VALIDATOR_5_PUBKEY
unstake_destination_pubkey = REPLACE_ME_5184_ZEROS
unstake_destination_fp     = REPLACE_ME_FOUNDATION_MULTISIG_ADDRESS
self_stake                 = 1000000000000000
commission_bps             = 500

[validator]
pubkey                     = REPLACE_ME_VALIDATOR_6_PUBKEY
unstake_destination_pubkey = REPLACE_ME_5184_ZEROS
unstake_destination_fp     = REPLACE_ME_FOUNDATION_MULTISIG_ADDRESS
self_stake                 = 1000000000000000
