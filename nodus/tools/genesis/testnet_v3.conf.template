# ═════════════════════════════════════════════════════════════════════
# NODUS CHAIN — VERSION-5 (cometbft + treasury + genesis outputs)
# GENESIS CONFIG — TEMPLATE
# ═════════════════════════════════════════════════════════════════════
#
# This file is a TEMPLATE. It does not derive as it stands: every
# `REPLACE_ME_<WHAT>` marker is a key, an identity or a ceremony value the
# operator must supply, and `check_genesis_conf.sh` refuses the file while
# any marker remains. Nothing below is a real key or fingerprint.
#
# How to fill it in, check it and derive it: README.md in this directory.
#
# THE FILE IS THE CHAIN'S IDENTITY. The chain id is a hash of the genesis
# document this file becomes, so every node of the fleet must derive from
# the SAME file, byte for byte. Fill it in ONCE, check it ONCE, then copy
# that one file to every node — never re-type it per node.
#
# Governing records for every number below:
#   docs/plans/decisions/2026-09-22-nodus-tokenomics-v3-operator.md §1
#   (cited below as "decision §1"), and — for the pools being keyless,
#   locked treasury rows instead of claimable allocations —
#   docs/plans/decisions/2026-09-28-treasury-pools-and-exact-self-stake.md
#   (cited below as "treasury decision"), and — for the genesis validators'
#   refund destination, the Foundation multisig address —
#   docs/plans/decisions/2026-09-29-general-multisig.md.
#
# Syntax: the parser is nodus/tools/nodus_v2_gen_config.c — `key = value`,
# `#` comments, LF line endings, lowercase hex, base-10 integers with no
# separators. Unknown, duplicate or missing keys are refused.
# ═════════════════════════════════════════════════════════════════════

# The cometbft genesis document with the nine [treasury] pools and the
# [genesis_output] blocks. 5 is the only version this build derives (4
# had no genesis outputs, 3 no treasury; both are refused).
config_version        = 5

# UTC milliseconds since the Unix epoch at which the chain starts. The
# derivation never reads a clock: the producer writes this value, and it
# is hashed into the chain id — so it is chosen once, written once, and
# the same file is copied to every node.
genesis_time_ms       = REPLACE_ME_GENESIS_TIME_MS

# PLACEHOLDER — the operator's choice. 0 and 1 both start the chain at
# height 1, but the raw value is part of the hashed document, so they are
# two DIFFERENT chain ids (nodus_v2_gen_config.c, the version-3 required
# key message). 1 is what the Genesis Protocol harness writes
# (nodus/tests/integration/stagef/stagef_up_v2.sh).
initial_height        = 1

# decision §1 "Toplam arz 1.000.000.000 NODUS, sabit" — 1 000 000 000
# NODUS × 10^8 raw units (decimal_unit below). Rule P.2 (gen_plan_build,
# nodus_witness_v2_gen.c): Σ allocations + Σ self_stake +
# reward_pool_initial + Σ treasury balances == total_supply_raw.
total_supply_raw      = 100000000000000000

# decision §1 "Epoch uzunluğu 720 blok". Must equal the build's compiled
# DNAC_EPOCH_LENGTH or the derivation refuses.
epoch_length          = 720

# The production blocks-per-year constant; must equal the build's
# compiled DNAC_BLOCKS_PER_YEAR (nodus/src/witness/nodus_witness_emission.h)
# or the derivation refuses.
blocks_per_year       = 6307200

# 1 NODUS = 10^8 raw units; must equal the compiled DNAC_DECIMAL_UNIT.
decimal_unit          = 100000000

# decision §1 "Yeni token basılmayacak" — the per-block mint is deleted
# and 0 is the only value the builder accepts. The key stays because it is
# a field of the canonical genesis encoding.
inflation_start_block = 0

# decision §1 "Konsensüs / validator ödülleri 200M" — 200 000 000 × 10^8.
reward_pool_initial   = 20000000000000000

# decision §1 "Ödeme her 24 epoch'ta yapılacak".
payout_interval_epochs = 24

# Final pre-testnet wipe W-C — the genesis values of the two fee
# parameters governance can later change (each becomes a height-0
# chain_config row and is part of the hashed document):
# docs/plans/decisions/2026-09-25-gas-price.md "Son wipe paketi" — 121 raw
# per declared gas unit, the gas rule is ON from the first block.
gas_price_raw_per_unit = 121
# docs/plans/decisions/2026-09-28-token-create-fee-governance.md — 1 000
# NODUS (10^11 raw) per token creation; governed range [10^8, 10^15].
token_create_fee_raw   = 100000000000

# ─────────────────────────────────────────────────────────────────────
# THE SEVEN GENESIS VALIDATORS
#
# decision §1 "Genesis'te 7 Foundation validatorı olacak. Her birine 10M
# NODUS stake ayrılacak" — exactly 7 blocks (the builder's Rule P.1), each
# self_stake = 10 000 000 × 10^8.
#
#   pubkey                     the validator's ML-DSA-87 public key
#                              (2592 bytes = 5184 lowercase hex);
#   unstake_destination_pubkey 5184 '0' characters on every genesis
#                              seat (`printf '0%.0s' $(seq 5184)`). The
#                              destination below is a MULTISIG address,
#                              which no single key opens; the field is
#                              still required by the parser and MUST be
#                              all zero on a genesis row (decision ONAY 2
#                              — the derivation and check_genesis_conf.sh
#                              both refuse anything else; the STAKE rule
#                              writes zeros for a foreign destination
#                              too);
#   unstake_destination_fp     the FOUNDATION MULTISIG ADDRESS (128
#                              lowercase hex), the SAME on all seven —
#                              general multisig, decision
#                              2026-09-29-general-multisig.md: a GENESIS
#                              validator's 10M came out of the
#                              Foundation's allocation, so when it
#                              retires the 10M is released to the
#                              Foundation's M-of-N address (a locked
#                              UTXO, spent with auth_kind 3). Print it
#                              with `nodus-cli msig address --m <M>
#                              --pubkey <each Foundation key's nodus.pk>`;
#                              check_genesis_conf.sh recomputes it from
#                              the same keys and refuses a mismatch;
#   commission_bps             PLACEHOLDER 500 (5 %). The commission is
#                              the validator's own choice (decision §1
#                              "Komisyonu validator belirleyecek; üst
#                              sınır %50" — at most 5000); 500 is not a
#                              policy, it is the value the harness writes.
# ─────────────────────────────────────────────────────────────────────

[validator]
pubkey                     = REPLACE_ME_VALIDATOR_1_PUBKEY
unstake_destination_pubkey = REPLACE_ME_5184_ZEROS
unstake_destination_fp     = REPLACE_ME_FOUNDATION_MULTISIG_ADDRESS
self_stake                 = 1000000000000000
commission_bps             = 500

[validator]
pubkey                     = REPLACE_ME_VALIDATOR_2_PUBKEY
unstake_destination_pubkey = REPLACE_ME_5184_ZEROS
unstake_destination_fp     = REPLACE_ME_FOUNDATION_MULTISIG_ADDRESS
self_stake                 = 1000000000000000
commission_bps             = 500

