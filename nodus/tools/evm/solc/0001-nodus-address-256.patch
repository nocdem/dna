+/// Nodus EVM: addresses are 32 bytes. An external function value is an address plus a 4-byte
+/// selector (36 bytes), which no longer fits the single word that ABI encoding, storage and
+/// memory use for it. Such values may only live on the stack.
+std::string const nodusExternalFunctionTypeMessage =
+	"Nodus EVM addresses are 32 bytes: an external function value (32-byte address + 4-byte selector) "
+	"does not fit the single 32-byte word used to ABI-encode it or to keep it in storage, memory or calldata. "
+	"External function types may only be used for local variables and parameters of internal functions; "
+	"pass the address and the selector separately instead.";
+
+bool containsExternalFunctionType(Type const* _type, std::set<StructDefinition const*>& _visitedStructs)
+{
+	if (!_type)
+		return false;
+	if (auto const* functionType = dynamic_cast<FunctionType const*>(_type))
+		return functionType->kind() == FunctionType::Kind::External;
+	if (auto const* arrayType = dynamic_cast<ArrayType const*>(_type))
+		return containsExternalFunctionType(arrayType->baseType(), _visitedStructs);
+	if (auto const* mappingType = dynamic_cast<MappingType const*>(_type))
+		return containsExternalFunctionType(mappingType->valueType(), _visitedStructs);
+	if (auto const* structType = dynamic_cast<StructType const*>(_type))
+	{
+		if (!_visitedStructs.insert(&structType->structDefinition()).second)
+			return false;
+		for (auto const& member: structType->structDefinition().members())
+			if (containsExternalFunctionType(member->annotation().type, _visitedStructs))
+				return true;
+	}
+	return false;
+}
+
+bool containsExternalFunctionType(Type const* _type)
+{
+	std::set<StructDefinition const*> visitedStructs;
+	return containsExternalFunctionType(_type, visitedStructs);
+}
+
+}
