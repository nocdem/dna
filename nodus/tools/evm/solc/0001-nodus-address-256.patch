 }
 
+bool Literal::looksLikeAddress32() const
+{
+	if (subDenomination() != SubDenomination::None)
+		return false;
+
+	if (!isHexNumber())
+		return false;
+
+	std::string const value = valueWithoutUnderscores();
+	if (value.length() != 66) // "0x" + 64 hex digits
+		return false;
+
+	return
+		value.find_first_of("abcdef", 2) != std::string::npos &&
+		value.find_first_of("ABCDEF", 2) != std::string::npos;
+}
+
+bool Literal::passesAddress32Checksum() const
+{
+	solAssert(isHexNumber(), "Expected hex number");
+	return util::passesAddress32Checksum(valueWithoutUnderscores(), true);
+}
+
+std::string Literal::getChecksummedAddress32() const
+{
+	solAssert(isHexNumber(), "Expected hex number");
+	std::string const address = valueWithoutUnderscores().substr(2);
+	if (address.length() != 64)
+		return std::string();
+	return util::getChecksummedAddress32(address);
+}
