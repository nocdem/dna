diff --git a/libevmasm/RuleList.h b/libevmasm/RuleList.h
index 34fe499..7bcff58 100644
--- a/libevmasm/RuleList.h
+++ b/libevmasm/RuleList.h
@@ -366,24 +366,9 @@ std::vector<SimplificationRule<Pattern>> simplificationRuleListPart5(
 		}
 	});
 
-	for (auto instr: {
-		Instruction::ADDRESS,
-		Instruction::CALLER,
-		Instruction::ORIGIN,
-		Instruction::COINBASE
-	})
-	{
-		assertThrow(Pattern::WordSize > 160, OptimizerException, "");
-		Word const mask = (Word(1) << 160) - 1;
-		rules.push_back({
-			Builtins::AND(Pattern{instr}, mask),
-			[=]() -> Pattern { return {instr}; }
-		});
-		rules.push_back({
-			Builtins::AND(mask, Pattern{instr}),
-			[=]() -> Pattern { return {instr}; }
-		});
-	}
+	// Nodus EVM: ADDRESS, CALLER, ORIGIN and COINBASE push 32-byte addresses, so
+	// AND(<instr>, 2**160 - 1) is NOT equal to <instr>. The upstream rule that dropped
+	// that mask is removed.
 
 	return rules;
 }
