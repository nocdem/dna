diff --git a/libsolidity/ast/AST.cpp b/libsolidity/ast/AST.cpp
index b59273b..0d4c4d9 100644
--- a/libsolidity/ast/AST.cpp
+++ b/libsolidity/ast/AST.cpp
@@ -1063,6 +1063,38 @@ std::string Literal::getChecksummedAddress() const
