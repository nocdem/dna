+bool solidity::util::passesAddress32Checksum(std::string const& _str, bool _strict)
+{
+	std::string s = _str.substr(0, 2) == "0x" ? _str : "0x" + _str;
+
+	if (s.length() != 66)
+		return false;
+
+	if (s.find_first_not_of("0123456789abcdefABCDEF", 2) != std::string::npos)
+		return false;
+
+	if (!_strict && (
+		s.find_first_of("abcdef", 2) == std::string::npos ||
+		s.find_first_of("ABCDEF", 2) == std::string::npos
+	))
+		return true;
+
+	return s == solidity::util::getChecksummedAddress32(s);
+}
+
+std::string solidity::util::getChecksummedAddress32(std::string const& _addr)
+{
+	std::string s = _addr.substr(0, 2) == "0x" ? _addr.substr(2) : _addr;
+	assertThrow(s.length() == 64, InvalidAddress, "");
+	assertThrow(s.find_first_not_of("0123456789abcdefABCDEF") == std::string::npos, InvalidAddress, "");
+
+	h256 hash = keccak256(boost::algorithm::to_lower_copy(s, std::locale::classic()));
+
+	std::string ret = "0x";
+	for (unsigned i = 0; i < 64; ++i)
+	{
+		char addressCharacter = s[i];
+		uint8_t nibble = hash[i / 2u] >> (4u * (1u - (i % 2u))) & 0xf;
+		if (nibble >= 8)
+			ret += toUpper(addressCharacter);
+		else
+			ret += toLower(addressCharacter);
+	}
+	return ret;
+}
