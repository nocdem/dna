diff --git a/libevmasm/Assembly.cpp b/libevmasm/Assembly.cpp
index 9dd203a..447fd8d 100644
--- a/libevmasm/Assembly.cpp
+++ b/libevmasm/Assembly.cpp
@@ -1164,6 +1164,15 @@ LinkerObject const& Assembly::assemble() const
 
 [[nodiscard]] std::pair<bytes, Assembly::LinkRef> Assembly::assemblePushLibraryAddress(AssemblyItem const& _item, size_t _pos) const
 {
+	// Nodus EVM: addresses are 32 bytes, but the linker (placeholders, link references,
+	// --libraries, standard-json "libraries") is built around 20-byte addresses. A library
+	// link reference that reaches the final bytecode (an external library call, address(L),
+	// a Yul linkersymbol) is refused instead of emitting a 20-byte address slot. References
+	// that the optimizer removes as unused never get here.
+	solUnimplemented(
+		"Nodus EVM addresses are 32 bytes: linking library \"" + m_libraries.at(_item.data()) + "\" is not supported. "
+		"Make the library functions internal, or deploy the library as a contract and call it through an interface."
+	);
 	return {
 		// solidity::evmasm::Instructions underlying type is uint8_t
 		// TODO: Change to std::to_underlying since C++23
@@ -1179,9 +1188,11 @@ LinkerObject const& Assembly::assemble() const
 
 [[nodiscard]] bytes Assembly::assemblePushDeployTimeAddress() const
 {
+	// Nodus EVM: the deploy-time (library self) address is 32 bytes: PUSH32 00...00,
+	// filled in by the library constructor (ContractCompiler::deployLibrary).
 	// solidity::evmasm::Instructions underlying type is uint8_t
 	// TODO: Change to std::to_underlying since C++23
-	return bytes(1, static_cast<uint8_t>(Instruction::PUSH20)) + bytes(20);
+	return bytes(1, static_cast<uint8_t>(Instruction::PUSH32)) + bytes(32);
 }
 
 [[nodiscard]] bytes Assembly::assembleTag(AssemblyItem const& _item, size_t _pos, bool _addJumpDest) const
