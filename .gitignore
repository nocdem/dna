# Task tracking (session-local, not committed)
tasks/
**/tasks/

# GSD planning docs (local-only)
.planning/

# Security audit files (private, never commit)
*SECURITY_AUDIT*
*COMPREHENSIVE_AUDIT*
*security_audit*
**/*AUDIT*
*audit*.md
# ...except agent definitions: .claude/agents/ holds subagent prompts (e.g.
# zk-auditor.md), never audit OUTPUT. Audit reports remain ignored everywhere.
!.claude/agents/*.md

# Build artifacts
*.o
*.so
*.a
*.dylib
**/build-asan/

# Out-of-tree CMake build directories (2026-08-28).
#
# Measured: these produced 75,612 of the repository's 75,887 untracked,
# non-ignored files (99.6%), against 1,996 tracked ones. Only build-asan was
# listed above, so every other variant counted as repository content.
#
# They are build output, not source: zero files under nodus/build-* are
# tracked. The trailing slash matches directories only, so a file such as
# messenger/build-android.sh is untouched.
nodus/build-*/

# Debug log files dumped at repo root
dna_debug_*.log

# Debian source packages (sqlcipher build inputs)
sqlcipher_*.dsc
sqlcipher_*.tar.xz
sqlcipher_*.tar.gz
sqlcipher_*.orig.tar.gz

# IDE/tool caches
**/.cache/

# Debug keystores
*.keystore
*.jks

# Design and plan documents (internal only)
**/plans/
**/*DESIGN*.md
**/*PLAN_*.md
docs/DNAC_CPUNK_DESIGN.md
docs/CPUNK_WHITEPAPER.md
docs/CPUNK_TOKENOMICS.md
docs/CPUNK_TECHNICAL_SPEC.md
docs/CPUNK_ROADMAP.md

# Confidential documents
docs/CPUNK_COUNCIL_DECISIONS.md
docs/REPO_SECURITY_ASSESSMENT.md

# Claude Code instructions (contain infra details, IPs, deploy commands)
CLAUDE.md
**/CLAUDE.md

# Internal docs (bugs, missing features, infra details)
BUGS.md
**/BUGS.md
**/MISSING_FEATURES.md
dnac/docs/WITNESS_NODES.md
dnac/tools/check_witness_announce.c
nodus/deploy/nodus.conf.example

# ── Agent/protocol files — local only (2026-08-27) ────────────────────
# CLAUDE.md carries the ORCHESTRATOR protocol and per-project rules;
# .claude/agents/ the subagent definitions. They describe how this
# repository is WORKED ON, not what it ships, and the repo is public.
# NOTE: git history retains every version already pushed — this governs
# what HEAD ships, not what has ever been exposed.
CLAUDE.md
**/CLAUDE.md
.claude/
