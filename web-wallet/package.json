{
  "name": "nodus-web-wallet",
  "version": "0.1.139",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "VITE_ENABLE_IXIOS=true vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:preview": "vite build --config vite.preview.config.js",
    "preview:preview": "vite preview --config vite.preview.config.js --host 127.0.0.1",
    "build:connect": "VITE_ENABLE_IXIOS=true vite build --config vite.connect.config.js",
    "preview:connect": "vite preview --config vite.connect.config.js --host 127.0.0.1",
    "test:connect": "node test/connect-smoke.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser-smoke.js",
    "test:security": "node test/browser-security.js && node test/browser-nodus.js",
    "cpunk:verify": "node scripts/verify-cpunk.js",
    "verify:networks": "node scripts/verify-networks.js",
    "test:portfolio": "node test/browser-portfolio.js",
    "test:ixios": "node test/browser-ixios.js",
    "test:vaults": "node test/browser-vaults.js",
    "test:messages": "node test/browser-messages.js",
    "test:requests": "node test/browser-connect-requests.js",
    "test:queue": "node test/browser-connect-queue.js",
    "test:roles": "node test/browser-nodus-roles.js",
    "test:state": "node test/browser-connect-state.js",
    "build:nodus-send": "bash scripts/build-nodus-send-wasm.sh",
    "build:connect-core": "bash scripts/build-connect-wasm.sh"
  },
  "dependencies": {
    "@metamask/approval-controller": "10.0.0",
    "@metamask/base-controller": "10.0.0",
    "@metamask/chain-agnostic-permission": "1.6.2",
    "@metamask/controller-utils": "12.3.0",
    "@metamask/eth-json-rpc-filters": "9.0.0",
    "@metamask/eth-json-rpc-middleware": "24.0.2",
    "@metamask/json-rpc-engine": "10.5.0",
    "@metamask/json-rpc-middleware-stream": "8.0.8",
    "@metamask/messenger": "3.0.0",
    "@metamask/object-multiplex": "2.1.0",
    "@metamask/permission-controller": "13.1.1",
    "@metamask/post-message-stream": "10.0.0",
    "@metamask/providers": "22.1.1",
    "@metamask/rpc-errors": "7.0.3",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.3.0",
    "@solana/rpc-spec-types": "8.3.0",
    "buffer": "6.0.3",
    "ethers": "6.17.0",
    "extension-port-stream": "5.0.3",
    "is-stream": "2.0.0",
    "loglevel": "1.9.2",
    "qrcode-generator": "2.0.4",
    "readable-stream": "4.7.0",
    "tronweb": "6.5.1",
    "uuid": "8.3.2",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@metamask/key-tree": "10.1.1",
    "jsqr": "1.4.0",
    "playwright": "1.58.2",
    "vite": "7.3.7"
  },
  "overrides": {
    "tronweb@6.5.1": {
      "axios": "1.20.0"
    },
    "follow-redirects": "1.16.1",
    "postcss": {
      "source-map-js": "1.2.2"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
